# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/projectcamp

# CORS - comma separated origins
CORS_ORIGIN=http://localhost:5173

# JWT Secrets & Expiry
ACCESS_TOKEN_SECRET=your-access-token-secret-here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here
REFRESH_TOKEN_EXPIRY=10d

# Mailtrap SMTP (https://mailtrap.io)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your-mailtrap-user
MAILTRAP_SMTP_PASS=your-mailtrap-pass

# Server URL for file uploads (no trailing slash)
SERVER_URL=http://localhost:3000

# Forgot password redirect URL (frontend route)
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password
